{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "claude-sonnet-5",

  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push *)",
      "Bash(make *)",
      "Bash(nasm *)",
      "Bash(x86_64-elf-*)",
      "Bash(grub-mkrescue *)",
      "Bash(qemu-system-x86_64 *)",
      "Bash(VBoxManage *)",
      "Read(~/.claude/settings.json)",
      "Read(~/oxys-os/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(sudo *)",
      "Bash(dd *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf /*)",
      "Bash(> /dev/*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(echo * > /dev/*)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(ssh *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(source *)",
      "Bash(. *)",
      "Bash(nohup *)",
      "Bash(disown *)",
      "Bash(kill -9 *)",
      "Bash(pkill -9 *)",
      "Bash(killall *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/.git/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(/etc/**)"
    ],
    "disableBypassPermissionsMode": "disable",
    "skipAutoPermissionPrompt": false
  },

  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_DISABLE_AUTO_UPDATES": "1"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Oxys-OS] Pre-flight check: $(date)\" >> .claude/hooks.log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Oxys-OS] Post-execution: $(date) - $CLAUDE_TOOL_COMMAND\" >> .claude/hooks.log"
          }
        ]
      }
    ]
  },

  "autoUpdatesChannel": "stable",

  "cleanupPeriodDays": 30,

  "editorMode": "vim",

  "statusLine": {
    "type": "command",
    "command": "echo \"[Oxys-OS] $(pwd)\"",
    "padding": 2
  },

  "spinnerTipsEnabled": false,

  "preferredNotifChannel": "terminal_bell"
}